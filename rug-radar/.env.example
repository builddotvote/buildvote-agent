# Copy to .env and fill in. Never commit .env or real secrets.

# Public Solana RPC endpoint used for per-launch scoring (the four signals).
# Use any public/free RPC (no API key needed).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Public Solana RPC endpoint used for launch *discovery* (websocket watcher +
# backstop poller). Separate from SOLANA_RPC_URL above because the official
# endpoint's rate limit was confirmed live to stall discovery almost
# entirely; this default handles the same volume without 429s but blocks
# token-balance methods behind a signup, so it can't replace SOLANA_RPC_URL
# outright. See rug-radar/README.md's "Live feed" section for the numbers.
SOLANA_DISCOVERY_RPC_URL=https://solana-rpc.publicnode.com

# Optional: websocket endpoint for real-time launch discovery, if your
# discovery RPC provider uses a different host for it than
# SOLANA_DISCOVERY_RPC_URL. Leave unset to derive it automatically
# (https -> wss, http -> ws) from SOLANA_DISCOVERY_RPC_URL.
#SOLANA_WS_URL=wss://solana-rpc.publicnode.com

# Port for the local web feed
PORT=8787
